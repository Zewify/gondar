// Committed signing defaults: ad hoc, for local builds and for releases alike (releases are
// ad hoc signed on purpose and installed only with scripts/install.sh). A local identity
// can go in Signing.local.xcconfig next to this file (gitignored).
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
